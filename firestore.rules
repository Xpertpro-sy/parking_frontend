rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isManager() {
      return isSignedIn() && currentUserData().role == "GESTIONNAIRE";
    }

    function managerWorkspaceAllowed() {
      let s = currentUserData().get("managerStatus", "");
      return s != "inactive" && s != "removed";
    }

    function managerActiveFor(ownerUid) {
      return isManager()
        && currentUserData().enterpriseOwnerUid == ownerUid
        && managerWorkspaceAllowed();
    }

    function hasManagerPermission(permission) {
      return !isManager() || currentUserData().permissions[permission] == true;
    }

    function canAccessWorkspace(ownerUid, permission) {
      return isSignedIn()
        && (
          request.auth.uid == ownerUid
          || (managerActiveFor(ownerUid) && hasManagerPermission(permission))
        );
    }

    // Reçus de location : même périmètre que les locations (listRentals charge rentals + rentalReceipts).
    function canAccessRentalReceiptWorkspace(ownerUid) {
      return canAccessWorkspace(ownerUid, "receipts") || canAccessWorkspace(ownerUid, "rentals");
    }

    // Mouvements comptables : saisie manuelle = comptabilité ; flux métier = permission du module concerné.
    function canCreateAccountMovementForOperation() {
      let ownerUid = request.resource.data.ownerUid;
      let op = request.resource.data.operationType;
      return canAccessWorkspace(ownerUid, "comptability")
        || (op == "sale" && canAccessWorkspace(ownerUid, "receipts"))
        || (op == "rental" && canAccessWorkspace(ownerUid, "rentals"))
        || (op == "reservation" && canAccessWorkspace(ownerUid, "reservations"))
        || (op == "repair" && canAccessWorkspace(ownerUid, "vehicles"));
    }

    function usersDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && usersDoc(request.auth.uid).data.role == "SUPER_ADMIN";
    }

    // Admin entreprise (pas gestionnaire) : document users requis.
    function isEnterpriseAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && usersDoc(request.auth.uid).data.role != "GESTIONNAIRE";
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow delete: if isOwner(userId);

      // Mise a jour : soi-meme, ou admin qui gere un gestionnaire de son entreprise.
      allow update: if isOwner(userId)
        || (
          isEnterpriseAdmin()
          && resource.data.role == "GESTIONNAIRE"
          && resource.data.enterpriseOwnerUid == request.auth.uid
          && request.resource.data.uid == userId
          && request.resource.data.role == "GESTIONNAIRE"
          && request.resource.data.enterpriseOwnerUid == resource.data.enterpriseOwnerUid
        );

      // Creation : son propre profil, ou admin qui provisionne un gestionnaire rattache a son entreprise.
      allow create: if (isOwner(userId) && request.resource.data.uid == userId)
        || (
          isEnterpriseAdmin()
          && request.resource.data.uid == userId
          && request.resource.data.role == "GESTIONNAIRE"
          && request.resource.data.enterpriseOwnerUid == request.auth.uid
        );
    }

    match /vehicles/{vehicleId} {
      // Lecture : périmètre entreprise ou super administrateur (stats / back-office).
      allow read: if canAccessWorkspace(resource.data.ownerUid, "vehicles") || isSuperAdmin();

      // Creation: le document doit appartenir a l'utilisateur connecte
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "vehicles");

      // Update/Delete: uniquement le proprietaire du document existant
      // + interdiction de changer le ownerUid
      allow update: if canAccessWorkspace(resource.data.ownerUid, "vehicles")
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canAccessWorkspace(resource.data.ownerUid, "vehicles");
    }

    match /sales/{saleId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "receipts");
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "receipts")
        && request.resource.data.vehicleId is string
        && request.resource.data.buyerName is string
        && request.resource.data.buyerPhone is string
        && request.resource.data.buyerAddress is string
        && request.resource.data.buyerIdCardNumber is string
        && request.resource.data.amount is number
        && request.resource.data.paymentMethod is string;
      allow update, delete: if false;
    }

    match /saleReceipts/{receiptId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "receipts");
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "receipts")
        && request.resource.data.saleId is string
        && request.resource.data.vehicleId is string
        && request.resource.data.receiptNumber is string
        && request.resource.data.amount is number;
      allow update: if false;
      allow delete: if canAccessWorkspace(resource.data.ownerUid, "receipts");
    }

    match /rentals/{rentalId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "rentals");
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "rentals")
        && request.resource.data.vehicleId is string
        && request.resource.data.tenantName is string
        && request.resource.data.tenantPhone is string
        && request.resource.data.tenantIdCardNumber is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.amount is number
        && request.resource.data.dailyPrice is number
        && request.resource.data.totalDays is number
        && request.resource.data.status is string;
      allow update: if canAccessWorkspace(resource.data.ownerUid, "rentals")
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canAccessWorkspace(resource.data.ownerUid, "rentals");
    }

    match /rentalReceipts/{receiptId} {
      allow read: if canAccessRentalReceiptWorkspace(resource.data.ownerUid);
      allow create: if canAccessRentalReceiptWorkspace(request.resource.data.ownerUid)
        && request.resource.data.rentalId is string
        && request.resource.data.vehicleId is string
        && request.resource.data.receiptNumber is string
        && request.resource.data.rentalAmount is number;
      allow update: if false;
      allow delete: if canAccessRentalReceiptWorkspace(resource.data.ownerUid);
    }

    match /reservations/{reservationId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "reservations");
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "reservations")
        && request.resource.data.vehicleId is string
        && request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.reservationDate is string
        && request.resource.data.amountPaid is number
        && request.resource.data.status is string;
      allow update: if canAccessWorkspace(resource.data.ownerUid, "reservations")
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canAccessWorkspace(resource.data.ownerUid, "reservations");
    }

    match /repairs/{repairId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "vehicles");
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "vehicles")
        && request.resource.data.vehicleId is string
        && request.resource.data.reason is string
        && request.resource.data.cost is number
        && request.resource.data.startDate is string
        && request.resource.data.status is string;
      allow update: if canAccessWorkspace(resource.data.ownerUid, "vehicles")
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    match /accountMovements/{movementId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "comptability");
      allow create: if canCreateAccountMovementForOperation()
        && request.resource.data.operationType is string
        && request.resource.data.direction is string
        && request.resource.data.category is string
        && request.resource.data.source is string
        && request.resource.data.reference is string
        && request.resource.data.amount is number
        && request.resource.data.operationDate is string
        && request.resource.data.vehicleId is string;
      allow update, delete: if false;
    }

    match /trashItems/{trashId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "trash");
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "trash")
        && request.resource.data.itemType is string
        && request.resource.data.sourceCollection is string
        && request.resource.data.sourceId is string
        && request.resource.data.title is string;
      allow update: if false;
      allow delete: if canAccessWorkspace(resource.data.ownerUid, "trash");
    }

    match /brandingSettings/{brandingId} {
      allow read: if isSignedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || managerActiveFor(resource.data.ownerUid)
        );
      allow create: if isSignedIn()
        && brandingId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.mode is string
        && request.resource.data.text is string
        && request.resource.data.imageScale is number;
      allow update: if isSignedIn()
        && brandingId == request.auth.uid
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.mode is string
        && request.resource.data.text is string
        && request.resource.data.imageScale is number;
      allow delete: if isSignedIn() && brandingId == request.auth.uid && resource.data.ownerUid == request.auth.uid;
    }

    // Plafond de gestionnaires par admin locataire (défaut côté appli si absent). Écriture : super admin uniquement.
    match /tenantAdminLimits/{adminUid} {
      allow read: if isOwner(adminUid) || isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && request.resource.data.ownerUid == adminUid
        && request.resource.data.maxManagers is int
        && request.resource.data.maxManagers >= 0
        && request.resource.data.maxManagers <= 500;
      allow delete: if false;
    }

    match /managerAccess/{accessId} {
      // Le gestionnaire doit pouvoir lire sa fiche même si inactive (pour afficher un message clair à la connexion).
      allow read: if isSignedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || (
            request.auth.token.email is string
            && resource.data.managerEmailNormalized == request.auth.token.email.lower()
          )
          || isSuperAdmin()
        );
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.managerEmail is string
        && request.resource.data.managerEmailNormalized is string
        && request.resource.data.permissions is map;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Tout le reste est refuse par defaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
