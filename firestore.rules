rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isManager() {
      return isSignedIn() && currentUserData().role == "GESTIONNAIRE";
    }

    function managerWorkspaceAllowed() {
      let s = currentUserData().get("managerStatus", "");
      return s != "inactive" && s != "removed";
    }

    function managerActiveFor(ownerUid) {
      return isManager()
        && currentUserData().enterpriseOwnerUid == ownerUid
        && managerWorkspaceAllowed();
    }

    function hasManagerPermission(permission) {
      return !isManager()
        || currentUserData().permissions.get(permission, false) == true
        || (
          permission == "ecommerceRequests"
          && (
            currentUserData().permissions.get("rentals", false) == true
            || currentUserData().permissions.get("reservations", false) == true
          )
        );
    }

    function canAccessWorkspace(ownerUid, permission) {
      let ownerUser = ownerUid is string ? usersDoc(ownerUid) : null;
      let resolvedOwnerUid = (
        ownerUser != null
        && ownerUser.exists()
        && ownerUser.data.role == "GESTIONNAIRE"
        && ownerUser.data.enterpriseOwnerUid is string
        && ownerUser.data.enterpriseOwnerUid != ""
      ) ? ownerUser.data.enterpriseOwnerUid : ownerUid;
      return isSignedIn()
        && (
          request.auth.uid == resolvedOwnerUid
          || (managerActiveFor(resolvedOwnerUid) && hasManagerPermission(permission))
        );
    }

    // Reçus de location : même périmètre que les locations (listRentals charge rentals + rentalReceipts).
    function canAccessRentalReceiptWorkspace(ownerUid) {
      return canAccessWorkspace(ownerUid, "receipts") || canAccessWorkspace(ownerUid, "rentals");
    }

    // Opérations location: autorisées via module Locations ou Véhicules.
    function canManageRentalsWorkspace(ownerUid) {
      return canAccessWorkspace(ownerUid, "rentals") || canAccessWorkspace(ownerUid, "vehicles");
    }

    function canAccessEcommerceRequestsWorkspace(ownerUid) {
      return canAccessWorkspace(ownerUid, "ecommerceRequests")
        || canAccessWorkspace(ownerUid, "rentals")
        || canAccessWorkspace(ownerUid, "reservations")
        || (isManager() && managerActiveFor(ownerUid));
    }

    function hasActiveEcommerceLink(ownerUid) {
      return exists(/databases/$(database)/documents/ecommerceLinks/$(ownerUid))
        && get(/databases/$(database)/documents/ecommerceLinks/$(ownerUid)).data.status == "active";
    }

    function hasMatchingActiveEcommerceLink(ownerUid, token) {
      return hasActiveEcommerceLink(ownerUid)
        && get(/databases/$(database)/documents/ecommerceLinks/$(ownerUid)).data.token == token;
    }

    // Mouvements comptables : saisie manuelle = comptabilité ; flux métier = permission du module concerné.
    function canCreateAccountMovementForOperation() {
      let ownerUid = request.resource.data.ownerUid;
      let op = request.resource.data.operationType;
      return canAccessWorkspace(ownerUid, "comptability")
        || (op == "sale" && canAccessWorkspace(ownerUid, "receipts"))
        || (op == "rental" && canAccessWorkspace(ownerUid, "rentals"))
        || (op == "reservation" && canAccessWorkspace(ownerUid, "reservations"))
        || (op == "repair" && canAccessWorkspace(ownerUid, "vehicles"));
    }

    function usersDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && usersDoc(request.auth.uid).data.role == "SUPER_ADMIN";
    }

    // Admin entreprise (pas gestionnaire) : document users requis.
    function isEnterpriseAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && usersDoc(request.auth.uid).data.role != "GESTIONNAIRE";
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || managerActiveFor(userId) || isSuperAdmin();
      allow delete: if isOwner(userId)
        || (
          isSuperAdmin()
          && request.auth.uid != userId
          && resource.data.get("role", "") != "SUPER_ADMIN"
        );

      // Mise a jour : soi-meme (sans toucher accountStatus), ou admin entreprise (gestionnaire), ou super admin.
      allow update: if (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["accountStatus"])
        )
        || (
          isEnterpriseAdmin()
          && resource.data.role == "GESTIONNAIRE"
          && resource.data.enterpriseOwnerUid == request.auth.uid
          && request.resource.data.uid == userId
          && request.resource.data.role == "GESTIONNAIRE"
          && request.resource.data.enterpriseOwnerUid == resource.data.enterpriseOwnerUid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["accountStatus"])
        )
        || (
          isSuperAdmin()
          && request.auth.uid != userId
          && resource.data.get("role", "") != "SUPER_ADMIN"
          && request.resource.data.role == resource.data.role
          && (
            resource.data.role != "GESTIONNAIRE"
            || request.resource.data.get("enterpriseOwnerUid", "") == resource.data.get("enterpriseOwnerUid", "")
          )
        );

      // Creation : son propre profil, ou admin qui provisionne un gestionnaire rattache a son entreprise.
      allow create: if (isOwner(userId) && request.resource.data.uid == userId)
        || (
          isEnterpriseAdmin()
          && request.resource.data.uid == userId
          && request.resource.data.role == "GESTIONNAIRE"
          && request.resource.data.enterpriseOwnerUid == request.auth.uid
        );
    }

    match /vehicles/{vehicleId} {
      // Lecture : périmètre entreprise ou super administrateur (stats / back-office).
      allow read: if canAccessWorkspace(resource.data.ownerUid, "vehicles")
        || isSuperAdmin()
        || hasActiveEcommerceLink(resource.data.ownerUid);

      // Creation: le document doit appartenir a l'utilisateur connecte
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "vehicles");

      // Update/Delete: uniquement le proprietaire du document existant
      // + interdiction de changer le ownerUid
      allow update: if (canAccessWorkspace(resource.data.ownerUid, "vehicles")
        || canAccessWorkspace(resource.data.ownerUid, "rentals"))
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canAccessWorkspace(resource.data.ownerUid, "vehicles")
        || (isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]));
    }

    match /sales/{saleId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "receipts") || isSuperAdmin();
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "receipts")
        && request.resource.data.vehicleId is string
        && request.resource.data.buyerName is string
        && request.resource.data.buyerPhone is string
        && request.resource.data.buyerAddress is string
        && request.resource.data.buyerIdCardNumber is string
        && request.resource.data.amount is number
        && request.resource.data.paymentMethod is string;
      allow update: if false;
      allow delete: if isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]);
    }

    match /saleReceipts/{receiptId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "receipts") || isSuperAdmin();
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "receipts")
        && request.resource.data.saleId is string
        && request.resource.data.vehicleId is string
        && request.resource.data.receiptNumber is string
        && request.resource.data.amount is number;
      allow update: if false;
      allow delete: if canAccessWorkspace(resource.data.ownerUid, "receipts")
        || (isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]));
    }

    match /rentals/{rentalId} {
      allow read: if canManageRentalsWorkspace(resource.data.ownerUid) || isSuperAdmin();
      allow create: if canManageRentalsWorkspace(request.resource.data.ownerUid)
        && request.resource.data.vehicleId is string
        && request.resource.data.tenantName is string
        && request.resource.data.tenantPhone is string
        && request.resource.data.tenantIdCardNumber is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.amount is number
        && request.resource.data.dailyPrice is number
        && request.resource.data.totalDays is number
        && request.resource.data.status is string;
      allow update: if canManageRentalsWorkspace(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canManageRentalsWorkspace(resource.data.ownerUid)
        || (isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]));
    }

    match /drivers/{driverId} {
      allow read: if canManageRentalsWorkspace(resource.data.ownerUid) || isSuperAdmin();
      allow create: if canManageRentalsWorkspace(request.resource.data.ownerUid)
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.rentalId is string
        && request.resource.data.vehicleId is string;
      allow update: if canManageRentalsWorkspace(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canManageRentalsWorkspace(resource.data.ownerUid)
        || (isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]));
    }

    match /ecommerceLinks/{linkId} {
      allow read: if isSuperAdmin()
        || resource.data.status == "active";
      allow create: if isSuperAdmin()
        && request.resource.data.ownerUid == linkId
        && request.resource.data.token is string
        && request.resource.data.status is string;
      allow update: if isSuperAdmin()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSuperAdmin();
    }

    match /ecommerceRequests/{requestId} {
      allow get: if canAccessEcommerceRequestsWorkspace(resource.data.ownerUid)
        || isSuperAdmin()
        || (
          resource.data.sourceToken is string
          && hasMatchingActiveEcommerceLink(resource.data.ownerUid, resource.data.sourceToken)
        );
      allow list: if canAccessEcommerceRequestsWorkspace(resource.data.ownerUid)
        || isSuperAdmin();
      allow create: if request.resource.data.ownerUid is string
        && request.resource.data.sourceToken is string
        && hasMatchingActiveEcommerceLink(request.resource.data.ownerUid, request.resource.data.sourceToken)
        && request.resource.data.vehicleId is string
        && request.resource.data.vehicleLabel is string
        && request.resource.data.requestType is string
        && request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.status == "pending";
      allow update: if canAccessEcommerceRequestsWorkspace(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canAccessEcommerceRequestsWorkspace(resource.data.ownerUid)
        || (isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]));
    }

    match /rentalReceipts/{receiptId} {
      allow read: if canAccessRentalReceiptWorkspace(resource.data.ownerUid) || isSuperAdmin();
      allow create: if canAccessRentalReceiptWorkspace(request.resource.data.ownerUid)
        && request.resource.data.rentalId is string
        && request.resource.data.vehicleId is string
        && request.resource.data.receiptNumber is string
        && request.resource.data.rentalAmount is number;
      allow update: if false;
      allow delete: if canAccessRentalReceiptWorkspace(resource.data.ownerUid)
        || (isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]));
    }

    match /reservations/{reservationId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "reservations") || isSuperAdmin();
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "reservations")
        && request.resource.data.vehicleId is string
        && request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.reservationDate is string
        && request.resource.data.amountPaid is number
        && request.resource.data.status is string;
      allow update: if canAccessWorkspace(resource.data.ownerUid, "reservations")
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canAccessWorkspace(resource.data.ownerUid, "reservations")
        || (isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]));
    }

    match /repairs/{repairId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "vehicles") || isSuperAdmin();
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "vehicles")
        && request.resource.data.vehicleId is string
        && request.resource.data.reason is string
        && request.resource.data.cost is number
        && request.resource.data.startDate is string
        && request.resource.data.status is string;
      allow update: if canAccessWorkspace(resource.data.ownerUid, "vehicles")
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]);
    }

    match /accountMovements/{movementId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "comptability") || isSuperAdmin();
      allow create: if canCreateAccountMovementForOperation()
        && request.resource.data.operationType is string
        && request.resource.data.direction is string
        && request.resource.data.category is string
        && request.resource.data.source is string
        && request.resource.data.reference is string
        && request.resource.data.amount is number
        && request.resource.data.operationDate is string
        && request.resource.data.vehicleId is string;
      allow update: if false;
      allow delete: if isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]);
    }

    match /trashItems/{trashId} {
      allow read: if canAccessWorkspace(resource.data.ownerUid, "trash") || isSuperAdmin();
      allow create: if canAccessWorkspace(request.resource.data.ownerUid, "trash")
        && request.resource.data.itemType is string
        && request.resource.data.sourceCollection is string
        && request.resource.data.sourceId is string
        && request.resource.data.title is string;
      allow update: if false;
      allow delete: if canAccessWorkspace(resource.data.ownerUid, "trash")
        || (isSuperAdmin() && resource.data.keys().hasAll(["ownerUid"]));
    }

    match /brandingSettings/{brandingId} {
      allow read: if isSuperAdmin()
        || (
          isSignedIn()
          && (
            resource.data.ownerUid == request.auth.uid
            || managerActiveFor(resource.data.ownerUid)
          )
        );
      allow create: if isSignedIn()
        && brandingId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.mode is string
        && request.resource.data.text is string
        && request.resource.data.imageScale is number;
      allow update: if isSignedIn()
        && brandingId == request.auth.uid
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.mode is string
        && request.resource.data.text is string
        && request.resource.data.imageScale is number;
      allow delete: if (isSignedIn() && brandingId == request.auth.uid && resource.data.ownerUid == request.auth.uid)
        || (isSuperAdmin() && resource.data.ownerUid is string);
    }

    // Plafond de gestionnaires par admin locataire (défaut côté appli si absent). Écriture : super admin uniquement.
    match /tenantAdminLimits/{adminUid} {
      allow read: if isOwner(adminUid) || isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && request.resource.data.ownerUid == adminUid
        && request.resource.data.maxManagers is int
        && request.resource.data.maxManagers >= 0
        && request.resource.data.maxManagers <= 500;
      allow delete: if isSuperAdmin();
    }

    function isTenantAdminOnly() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && usersDoc(request.auth.uid).data.role == "ADMIN";
    }

    // Demandes de paiement abonnement (Orange Money). Création : admin locataire uniquement.
    // Lecture : super admin ; propriétaire de la demande (même uid que ownerUid) ; gestionnaire rattaché à l’entreprise.
    // On n’exige pas isTenantAdminOnly() pour la lecture : seul le créateur peut avoir ownerUid == request.auth.uid (règle create).
    match /subscriptionRequests/{requestId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || (
          isManager()
          && managerWorkspaceAllowed()
          && resource.data.ownerUid == currentUserData().enterpriseOwnerUid
        );

      allow create: if isTenantAdminOnly()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.planId in ["1m", "3m", "6m", "1y"]
        && request.resource.data.depositReference is string
        && request.resource.data.depositReference.size() >= 4
        && request.resource.data.amountCfa is int
        && request.resource.data.amountCfa > 0
        && request.resource.data.amountCfa <= 1000000
        && request.resource.data.ownerEmail is string
        && request.resource.data.ownerDisplayName is string;

      allow update: if isSuperAdmin()
        && resource.data.status == "pending"
        && (request.resource.data.status == "approved" || request.resource.data.status == "rejected")
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.amountCfa == resource.data.amountCfa
        && request.resource.data.depositReference == resource.data.depositReference;

      allow delete: if isSuperAdmin() && resource.data.ownerUid is string;
    }

    // Abonnement actif par entreprise (ownerUid = admin locataire).
    // Création « essai » : une fois, par l’admin locataire, plan trial uniquement (super admin garde tous les droits).
    match /tenantSubscriptions/{ownerUid} {
      allow read: if isSuperAdmin()
        || isOwner(ownerUid)
        || (isManager() && managerActiveFor(ownerUid));
      allow create: if isSuperAdmin()
        || (
          isTenantAdminOnly()
          && request.auth.uid == ownerUid
          && !exists(/databases/$(database)/documents/tenantSubscriptions/$(ownerUid))
          && request.resource.data.ownerUid == ownerUid
          && request.resource.data.planId == "trial"
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt < request.time + duration(40, 'd')
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasAll(['ownerUid', 'planId', 'expiresAt', 'updatedAt'])
        );
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin()
        && resource.data.ownerUid == ownerUid
        && resource.data.keys().hasAll(["ownerUid", "planId"]);
    }

    match /managerAccess/{accessId} {
      // Le gestionnaire doit pouvoir lire sa fiche même si inactive (pour afficher un message clair à la connexion).
      allow read: if isSignedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || (
            request.auth.token.email is string
            && resource.data.managerEmailNormalized == request.auth.token.email.lower()
          )
          || isSuperAdmin()
        );
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.managerEmail is string
        && request.resource.data.managerEmailNormalized is string
        && request.resource.data.permissions is map;
      allow update: if (
          isSignedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
        )
        || (
          isSuperAdmin()
          && request.resource.data.ownerUid == resource.data.ownerUid
        );
      allow delete: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isSuperAdmin();
    }

    // Tout le reste est refuse par defaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
