rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Chaque utilisateur lit/edite uniquement son propre document.
      allow read, update, delete: if isOwner(userId);

      // Creation autorisee uniquement pour son propre uid
      // + garde-fou: le champ uid du document doit correspondre au path.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
    }

    match /vehicles/{vehicleId} {
      // Lecture autorisee uniquement pour le proprietaire
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Creation: le document doit appartenir a l'utilisateur connecte
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Update/Delete: uniquement le proprietaire du document existant
      // + interdiction de changer le ownerUid
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Tout le reste est refuse par defaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
